{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devswitchboard.dev/schemas/approved-handoff.schema.json",
  "title": "Approved Handoff",
  "type": "object",
  "required": ["$schema_file", "schema", "schema_version", "project", "task_id", "revision", "status", "task_class", "goal", "baseline", "context", "workflow_state", "superpowers", "routing", "execution", "developer_decisions", "confidence", "task_profile", "completed_gates", "approved_strategy", "scope", "acceptance_criteria", "verification_expectations", "readiness"],
  "properties": {
    "$schema_file": { "const": "../schemas/approved-handoff.schema.json" },
    "schema": { "const": "approved_handoff" },
    "schema_version": { "const": "0.1" },
    "project": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "status": { "const": "ready_for_codex_preflight" },
    "task_class": { "enum": ["small", "bounded", "architectural", "security_sensitive"] },
    "goal": { "type": "string", "minLength": 1 },
    "baseline": {
      "type": "object",
      "required": ["state", "github_remote_available", "local_repository_available"],
      "properties": {
        "state": { "enum": ["uninitialized", "initialized"] },
        "github_remote_available": { "type": "boolean" },
        "local_repository_available": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "required": ["depth", "freshness", "local_delta_required"],
      "properties": {
        "depth": { "enum": ["low", "medium", "high"] },
        "freshness": { "enum": ["adequate", "fresh"] },
        "local_delta_required": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "workflow_state": {
      "type": "object",
      "required": ["requirement_discovery", "design", "specification", "developer_approval"],
      "properties": {
        "requirement_discovery": { "const": "completed" },
        "design": { "const": "completed" },
        "specification": { "const": "completed" },
        "developer_approval": { "const": true }
      },
      "additionalProperties": false
    },
    "superpowers": {
      "type": "object",
      "required": ["brainstorming"],
      "properties": {
        "brainstorming": {
          "type": "object",
          "required": ["satisfied_upstream", "source"],
          "properties": {
            "satisfied_upstream": { "type": "boolean" },
            "source": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "routing": {
      "type": "object",
      "required": ["codex_preflight", "implementation_planning", "implementation", "review", "verification"],
      "properties": {
        "codex_preflight": { "$ref": "#/$defs/active_phase" },
        "implementation_planning": { "$ref": "#/$defs/owned_phase" },
        "implementation": { "$ref": "#/$defs/implementation_phase" },
        "review": { "$ref": "#/$defs/review_phase" },
        "verification": { "$ref": "#/$defs/active_phase" }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": ["isolation", "methodology"],
      "properties": {
        "isolation": {
          "type": "object",
          "required": ["recommended"],
          "properties": { "recommended": { "type": "boolean" } },
          "additionalProperties": false
        },
        "methodology": {
          "type": "object",
          "required": ["adapter", "path"],
          "properties": {
            "adapter": { "const": "superpowers" },
            "path": { "enum": ["direct", "bounded", "architectural", "security_sensitive"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "developer_decisions": {
      "type": "object",
      "required": ["routing_recommendation_approved", "implementation_subagents", "workspace_isolation"],
      "properties": {
        "routing_recommendation_approved": { "type": "boolean" },
        "implementation_subagents": { "type": "boolean" },
        "workspace_isolation": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "confidence": { "enum": ["low", "medium", "high"] },
    "task_profile": {
      "type": "object",
      "properties": { "profile_status": { "const": "final" } },
      "$ref": "task-profile.schema.json"
    },
    "completed_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["gate", "status", "evidence_source"],
        "properties": {
          "gate": { "type": "string", "minLength": 1 },
          "status": { "enum": ["passed", "approved", "reused"] },
          "evidence_source": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "approved_strategy": {
      "type": "object",
      "required": ["implementation_subagents", "workspace_isolation", "review_subagent", "methodology_adapter"],
      "properties": {
        "implementation_subagents": { "type": "boolean" },
        "workspace_isolation": { "type": "boolean" },
        "review_subagent": { "type": "boolean" },
        "methodology_adapter": { "const": "superpowers" }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": ["included", "excluded"],
      "properties": {
        "included": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "excluded": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "verification_expectations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "readiness": {
      "type": "object",
      "required": ["intent_clear", "material_decisions_resolved", "scope_bounded", "acceptance_testable", "critical_uncertainty", "unresolved_conflicts", "developer_approval"],
      "properties": {
        "intent_clear": { "const": "pass" },
        "material_decisions_resolved": { "const": "pass" },
        "scope_bounded": { "const": "pass" },
        "acceptance_testable": { "const": "pass" },
        "critical_uncertainty": { "const": "none" },
        "unresolved_conflicts": { "const": "none" },
        "developer_approval": { "const": true }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "active_phase": {
      "type": "object",
      "required": ["active"],
      "properties": { "active": { "type": "boolean" } },
      "additionalProperties": false
    },
    "owned_phase": {
      "type": "object",
      "required": ["active", "owner"],
      "properties": { "active": { "type": "boolean" }, "owner": { "enum": ["chat", "codex", "developer"] } },
      "additionalProperties": false
    },
    "implementation_phase": {
      "type": "object",
      "required": ["owner", "subagents"],
      "properties": { "owner": { "enum": ["chat", "codex", "developer"] }, "subagents": { "type": "boolean" } },
      "additionalProperties": false
    },
    "review_phase": {
      "type": "object",
      "required": ["active", "subagent"],
      "properties": { "active": { "type": "boolean" }, "subagent": { "type": "boolean" } },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
