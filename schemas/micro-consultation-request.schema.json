{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devswitchboard.dev/schemas/micro-consultation-request.schema.json",
  "title": "Micro Consultation Request",
  "type": "object",
  "oneOf": [
    {
      "properties": {
        "requester": { "const": "chat" },
        "responder": { "const": "codex" }
      }
    },
    {
      "properties": {
        "requester": { "const": "codex" },
        "responder": { "const": "chat" }
      }
    }
  ],
  "required": [
    "$schema_file",
    "schema",
    "schema_version",
    "task_id",
    "revision",
    "consultation_id",
    "status",
    "requester",
    "responder",
    "phase_owner",
    "consultation_type",
    "focused_question",
    "why_it_matters",
    "requested_evidence",
    "authority"
  ],
  "properties": {
    "$schema_file": { "const": "../schemas/micro-consultation-request.schema.json" },
    "schema": { "const": "micro_consultation_request" },
    "schema_version": { "const": "0.1" },
    "task_id": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "consultation_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["open", "answered", "cancelled"] },
    "requester": { "enum": ["chat", "codex"] },
    "responder": { "enum": ["chat", "codex"] },
    "phase_owner": { "enum": ["chat", "codex", "developer"] },
    "consultation_type": { "enum": ["repository_fact", "shared_baseline_fact", "artifact_clarification"] },
    "focused_question": { "type": "string", "minLength": 1 },
    "why_it_matters": { "type": "string", "minLength": 1 },
    "requested_evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "authority": {
      "type": "object",
      "required": ["may_change_intent", "may_transfer_phase_ownership", "boundary"],
      "properties": {
        "may_change_intent": { "const": false },
        "may_transfer_phase_ownership": { "const": false },
        "boundary": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
