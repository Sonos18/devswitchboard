{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devswitchboard.dev/schemas/micro-consultation-response.schema.json",
  "title": "Micro Consultation Response",
  "type": "object",
  "oneOf": [
    {
      "properties": {
        "requester": { "const": "chat" },
        "responder": { "const": "codex" }
      }
    },
    {
      "properties": {
        "requester": { "const": "codex" },
        "responder": { "const": "chat" }
      }
    }
  ],
  "required": [
    "$schema_file",
    "schema",
    "schema_version",
    "task_id",
    "revision",
    "consultation_id",
    "status",
    "requester",
    "responder",
    "phase_owner",
    "consultation_type",
    "in_response_to",
    "finding",
    "evidence",
    "implication",
    "decision"
  ],
  "properties": {
    "$schema_file": { "const": "../schemas/micro-consultation-response.schema.json" },
    "schema": { "const": "micro_consultation_response" },
    "schema_version": { "const": "0.1" },
    "task_id": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "consultation_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["answered", "unable_to_answer"] },
    "requester": { "enum": ["chat", "codex"] },
    "responder": { "enum": ["chat", "codex"] },
    "phase_owner": { "enum": ["chat", "codex", "developer"] },
    "consultation_type": { "enum": ["repository_fact", "shared_baseline_fact", "artifact_clarification"] },
    "in_response_to": {
      "type": "object",
      "required": ["consultation_id", "request_revision"],
      "properties": {
        "consultation_id": { "type": "string", "minLength": 1 },
        "request_revision": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "finding": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "implication": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "decision": { "const": "none" }
  },
  "additionalProperties": false
}
