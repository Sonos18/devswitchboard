{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devswitchboard.dev/schemas/verification-report.schema.json",
  "title": "Verification Report",
  "type": "object",
  "oneOf": [
    {
      "required": ["status", "checks", "failed_criteria"],
      "properties": {
        "status": { "const": "pass" },
        "checks": {
          "type": "array",
          "items": { "type": "object", "properties": { "result": { "const": "pass" } } }
        },
        "failed_criteria": { "type": "array", "maxItems": 0 }
      }
    },
    {
      "required": ["status", "failed_criteria"],
      "properties": {
        "status": { "const": "fail" },
        "failed_criteria": { "type": "array", "minItems": 1 }
      }
    }
  ],
  "required": ["$schema_file", "schema", "schema_version", "task_id", "revision", "status", "fresh_after_last_change", "checks", "failed_criteria", "developer_acceptance_required"],
  "properties": {
    "$schema_file": { "const": "../schemas/verification-report.schema.json" },
    "schema": { "const": "verification_report" },
    "schema_version": { "const": "0.1" },
    "task_id": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["pass", "fail"] },
    "fresh_after_last_change": { "const": true },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["criterion", "method", "result", "evidence"],
        "properties": {
          "criterion": { "type": "string", "minLength": 1 },
          "method": { "type": "string", "minLength": 1 },
          "result": { "enum": ["pass", "fail"] },
          "evidence": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "failed_criteria": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "developer_acceptance_required": { "const": true }
  },
  "additionalProperties": false
}
