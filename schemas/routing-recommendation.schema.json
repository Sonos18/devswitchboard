{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devswitchboard.dev/schemas/routing-recommendation.schema.json",
  "title": "Routing Recommendation",
  "type": "object",
  "required": ["$schema_file", "schema", "schema_version", "task_id", "revision", "phase", "surface", "workflow", "resources", "matched_rule", "rationale", "developer_approval_required", "invalidation_conditions"],
  "properties": {
    "$schema_file": { "const": "../schemas/routing-recommendation.schema.json" },
    "schema": { "const": "routing_recommendation" },
    "schema_version": { "const": "0.1" },
    "task_id": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "phase": { "enum": ["requirement_discovery", "design", "specification", "codex_preflight", "implementation_planning", "implementation", "review", "verification", "handoff"] },
    "surface": { "enum": ["chat", "codex", "developer"] },
    "workflow": { "type": "string", "minLength": 1 },
    "resources": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "matched_rule": { "type": "string", "pattern": "^R0(0[1-9]|1[0-2])$" },
    "rationale": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "developer_approval_required": { "type": "boolean" },
    "invalidation_conditions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "additionalProperties": false
}
