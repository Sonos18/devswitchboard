{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devswitchboard.dev/schemas/dogfood-record.schema.json",
  "title": "Dogfood Measurement Record",
  "type": "object",
  "oneOf": [
    {
      "required": ["result", "review", "verification"],
      "properties": {
        "result": { "const": "pass" },
        "review": { "type": "object", "properties": { "status": { "enum": ["pass", "findings_remediated"] } } },
        "verification": { "type": "object", "properties": { "status": { "const": "pass" } } }
      }
    },
    { "required": ["result"], "properties": { "result": { "enum": ["not_run", "fail"] } } }
  ],
  "required": ["$schema_file", "schema", "schema_version", "record_type", "task_id", "revision", "authority", "approved_route", "execution_strategy", "gates", "measurements", "preflight", "review", "verification", "findings", "developer_controls", "result", "observations", "next_action"],
  "properties": {
    "$schema_file": { "const": "../schemas/dogfood-record.schema.json" },
    "schema": { "const": "dogfood_record" },
    "schema_version": { "const": "0.1" },
    "record_type": { "enum": ["template", "run"] },
    "task_id": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "authority": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "approved_route": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "execution_strategy": {
      "type": "object",
      "required": ["implementation_subagents", "review_subagent", "workspace_isolation", "methodology_adapter"],
      "properties": {
        "implementation_subagents": { "type": "boolean" },
        "review_subagent": { "type": "boolean" },
        "workspace_isolation": { "type": "boolean" },
        "methodology_adapter": { "const": "superpowers" }
      },
      "additionalProperties": false
    },
    "gates": {
      "type": "object",
      "required": ["reused", "repeated"],
      "properties": {
        "reused": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "repeated": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "measurements": {
      "type": "object",
      "required": ["phase_timings", "clarification_loops", "re_routes", "verification_failures", "developer_overrides"],
      "properties": {
        "phase_timings": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "clarification_loops": { "type": "integer", "minimum": 0 },
        "re_routes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "verification_failures": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "developer_overrides": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "decision_value_checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["checkpoint_id", "decision", "context_source", "missing_fact", "material_to", "evidence"],
            "properties": {
              "checkpoint_id": { "type": "string", "minLength": 1 },
              "decision": { "enum": ["MORE_CONTEXT_REQUIRED", "NO_MORE_CONTEXT_NEEDED"] },
              "context_source": { "enum": ["REMOTE", "LOCAL", "INTENT", "NONE"] },
              "missing_fact": {
                "oneOf": [
                  { "type": "string", "minLength": 1 },
                  { "type": "null" }
                ]
              },
              "material_to": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            },
            "oneOf": [
              {
                "properties": {
                  "decision": { "const": "MORE_CONTEXT_REQUIRED" },
                  "context_source": { "enum": ["REMOTE", "LOCAL", "INTENT"] },
                  "missing_fact": { "type": "string", "minLength": 1 },
                  "material_to": { "type": "array", "minItems": 1 }
                }
              },
              {
                "properties": {
                  "decision": { "const": "NO_MORE_CONTEXT_NEEDED" },
                  "context_source": { "const": "NONE" },
                  "missing_fact": { "type": "null" },
                  "material_to": { "type": "array", "maxItems": 0 }
                }
              }
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "preflight": {
      "type": "object",
      "required": ["outcome", "adaptations", "conflicts"],
      "properties": {
        "outcome": { "enum": ["not_run", "compatible", "compatible_with_adaptation", "blocked_by_conflict"] },
        "adaptations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "conflicts": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": ["status", "findings"],
      "properties": {
        "status": { "enum": ["not_run", "pass", "findings_remediated", "fail"] },
        "findings": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "required": ["status", "checks"],
      "properties": {
        "status": { "enum": ["not_run", "pass", "fail"] },
        "checks": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "area", "description", "correction", "status"],
        "properties": {
          "type": { "type": "string", "minLength": 1 },
          "area": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "correction": { "type": "string", "minLength": 1 },
          "status": { "enum": ["open", "remediated"] }
        },
        "additionalProperties": false
      }
    },
    "developer_controls": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "result": { "enum": ["not_run", "pass", "fail"] },
    "observations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "next_action": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
